{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "vars": "all" }],
    "no-console": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "certificados/",
    "imagenes/",
    "js/baffle.min.js"
  ]
}
